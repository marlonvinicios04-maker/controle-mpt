rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function meuPerfil() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function ativo() {
      return logado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && meuPerfil().ativo == true;
    }
    function admin() { return ativo() && meuPerfil().perfil == 'admin'; }

    // Indica se o administrador já foi criado (lido antes do login)
    match /meta/admin {
      allow read: if true;
      allow create: if logado() && request.resource.data.uid == request.auth.uid;
      allow update: if admin();
      allow delete: if false;
    }

    // Cadastro de usuários do app
    match /usuarios/{uid} {
      allow read: if ativo() || (logado() && request.auth.uid == uid);
      allow create: if admin()
        || (logado() && request.auth.uid == uid
            && request.resource.data.perfil == 'admin'
            && !exists(/databases/$(database)/documents/meta/admin)
            && getAfter(/databases/$(database)/documents/meta/admin).data.uid == request.auth.uid);
      allow update: if admin();
      allow delete: if admin() && request.auth.uid != uid;
    }

    // Materiais (entradas e saídas)
    match /materiais/{id} {
      allow read, create, update: if ativo();
      allow delete: if admin();
    }

    // Fotos dos materiais
    match /fotos/{id} {
      allow read, write: if ativo();
    }

    // Logo e configurações (lidas na tela de login)
    match /config/{id} {
      allow read: if true;
      allow write: if admin();
    }
  }
}
